@@ -0,0 +1,89 @@
+---
+layout: default
+---
+
+{% include base_path %}
+{% assign author = site.author %}
+
+<main class="home" role="main">
+  <article class="home__article">
+
+    {%- comment -%} ---------- Header: photo, name, affiliation, links ---------- {%- endcomment -%}
+    <header class="home__header">
+      <img class="home__avatar" src="{{ base_path }}/images/{{ page.avatar | default: author.avatar }}" alt="{{ author.name }}" width="144" height="144" fetchpriority="high">
+      <div class="home__id">
+        <h1 class="home__name">{{ author.name }}</h1>
+        {% if page.tagline %}<p class="home__tagline">{{ page.tagline }}</p>{% endif %}
+        <p class="home__meta">
+          {%- for item in page.affiliation -%}{{ item }} · {% endfor -%}
+          {{ author.email | replace: "@", " [at] " | replace: ".", " [dot] " }}
+        </p>
+        <p class="home__links">
+          {%- capture links -%}
+            {% if page.cv %}<a href="{{ base_path }}{{ page.cv }}" target="_blank" rel="noopener">CV</a>|{% endif %}
+            {% if author.googlescholar %}<a href="{{ author.googlescholar }}" target="_blank" rel="noopener">Scholar</a>|{% endif %}
+            {% if author.github %}<a href="https://github.com/{{ author.github }}" target="_blank" rel="noopener">GitHub</a>|{% endif %}
+            {% if author.linkedin %}<a href="https://www.linkedin.com/in/{{ author.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>|{% endif %}
+            {% if author.orcid %}<a href="{{ author.orcid }}" target="_blank" rel="noopener">ORCID</a>|{% endif %}
+          {%- endcapture -%}
+          {%- assign link_list = links | strip | split: "|" -%}
+          {%- for l in link_list -%}{%- assign l = l | strip -%}{%- if l != "" -%}{% unless forloop.first %}<span class="home__sep"> · </span>{% endunless %}{{ l }}{%- endif -%}{%- endfor -%}
+        </p>
+      </div>
+    </header>
+
+    {%- comment -%} ---------- Intro (the markdown body of the page) ---------- {%- endcomment -%}
+    <section class="home__intro">
+      {{ content }}
+    </section>
+
+    {%- comment -%} ---------- News (edit _data/news.yml) ---------- {%- endcomment -%}
+    {% if site.data.news and site.data.news.size > 0 %}
+    <section class="home__section" id="news">
+      <h2 class="home__h2">News</h2>
+      <div class="news">
+        {% for item in site.data.news %}
+        <div class="news__item">
+          <span class="news__date">{{ item.date }}</span>
+          <span class="news__text">{{ item.text | markdownify | remove: "<p>" | remove: "</p>" | strip }}</span>
+        </div>
+        {% endfor %}
+      </div>
+    </section>
+    {% endif %}
+
+    {%- comment -%} ---------- Selected research (portfolio items with `selected: true`) ---------- {%- endcomment -%}
+    {% assign selected = site.portfolio | where: "selected", true | sort: "selected_order" %}
+    {% if selected.size > 0 %}
+    <section class="home__section" id="research">
+      <h2 class="home__h2">Selected Research</h2>
+      <div class="research">
+        {% for post in selected %}
+          {% assign media = post.selected_media | default: post.header.teaser %}
+          {% if media contains "://" %}{% assign media_path = media %}{% else %}{% assign media_path = media | prepend: base_path %}{% endif %}
+          {% assign media_ext = media | split: "." | last | downcase %}
+          <article class="research__card">
+            <a class="research__media" href="{{ base_path }}{{ post.url }}" tabindex="-1" aria-hidden="true">
+              {% if media_ext == "webm" or media_ext == "mp4" %}
+                <video src="{{ media_path }}" autoplay loop muted playsinline preload="metadata"></video>
+              {% else %}
+                <img src="{{ media_path }}" alt="" loading="lazy">
+              {% endif %}
+            </a>
+            <div class="research__body">
+              <h3 class="research__title"><a href="{{ base_path }}{{ post.url }}">{{ post.title }}</a></h3>
+              <p class="research__desc">{{ post.summary | default: post.excerpt | markdownify | strip_html | strip }}</p>
+              <p class="research__links">
+                <a href="{{ base_path }}{{ post.url }}">[project]</a>
+                {% for link in post.links %}<span class="home__sep"> · </span><a href="{{ link.url }}" target="_blank" rel="noopener">[{{ link.label }}]</a>{% endfor %}
+              </p>
+            </div>
+          </article>
+        {% endfor %}
+      </div>
+      <p class="home__more"><a href="{{ base_path }}/portfolio/">See all projects →</a></p>
+    </section>
+    {% endif %}
+
+  </article>
+</main>
